# --- Database ---
DATABASE_URL=postgresql://username:password@host:5432/database

# --- Google / Gemini ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- App behavior ---
TIMEZONE=UTC
GMAIL_QUERY=
GMAIL_MAX_RESULTS=20
DEFAULT_EVENT_DURATION_MIN=60
SCHEDULER_REFRESH_MINUTES=10

# --- Notifications (Gmail SMTP) ---
NOTIFY_EMAIL_FROM=your_sender@gmail.com
NOTIFY_EMAIL_PASSWORD=your_gmail_app_password
NOTIFY_EMAIL_TO=

# --- Admin endpoint protection ---
ADMIN_API_KEY=replace_with_strong_secret

# --- Postgres (for docker-compose local db service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_assistant

# --- Frontend -> backend ---
# For Streamlit deployment, point to your backend URL.
API_BASE_URL=http://localhost:8000
